{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aphasia-llm-eval/task.schema.json",
  "title": "aphasia-llm-eval task",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "title",
    "category",
    "version",
    "description",
    "gold",
    "input",
    "prompt",
    "output",
    "comparison",
    "headline"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "references": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "gold": {
      "type": "object",
      "required": ["parser"],
      "properties": {
        "file": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "parser": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "uniqueItems": true
        },
        "optional_fields": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "uniqueItems": true
        },
        "renderer": {"enum": ["plain", "numbered_tokens"]}
      },
      "additionalProperties": false
    },
    "tagset": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "prompt": {
      "type": "object",
      "required": ["system", "user_template"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "user_template": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["format", "schema"],
      "properties": {
        "format": {"const": "json"},
        "schema": {"type": "object"}
      },
      "additionalProperties": false
    },
    "derived": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "function", "args"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "function": {"enum": ["percentage", "per_minute", "ratio", "counts_by"]},
          "args": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "optional": {"type": "boolean"}
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {"properties": {"function": {"const": "counts_by"}}},
            "then": {"properties": {"args": {"minItems": 1, "maxItems": 1}}},
            "else": {"properties": {"args": {"minItems": 2, "maxItems": 2}}}
          }
        ]
      }
    },
    "comparison": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["numeric_fields", "token_tags"]},
        "fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "tolerance": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "tag_field": {"type": "string", "minLength": 1},
        "index_field": {"type": "string", "minLength": 1},
        "breakdown": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "numeric_fields"}}},
          "then": {"required": ["fields"]}
        }
      ]
    },
    "headline": {
      "type": "object",
      "required": ["stat", "better"],
      "properties": {
        "stat": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "better": {"enum": ["lower", "higher"]}
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "temperature": {"type": "number"},
        "max_tokens": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
